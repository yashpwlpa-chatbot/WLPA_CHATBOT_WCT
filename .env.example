# ============================================================
# WLPA Bot – Environment Configuration (V2)
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real .env to source control.
# ============================================================

# HTTP server
PORT=3000
NODE_ENV=development

# MongoDB connection string (REQUIRED)
# Example local: mongodb://127.0.0.1:27017/wlpa_bot
# Example Atlas:  mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/wlpa_bot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wlpa_bot

# ============================================================
# TELEGRAM SETTINGS
# ============================================================
# Telegram bot token from @BotFather (REQUIRED)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram transport mode (default false = polling)
USE_WEBHOOK=false

# Public HTTPS URL for Telegram webhook (only if USE_WEBHOOK=true)
WEBHOOK_URL=

# ============================================================
# WHATSAPP CLOUD API SETTINGS
# ============================================================
# WhatsApp Access Token from Meta Developer Console (REQUIRED for WhatsApp)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# WhatsApp Phone Number ID from Meta Developer Console
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook Verify Token (set any string for verification)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token_here

# WhatsApp App Secret from Meta Developer Console (for signature verification)
WHATSAPP_APP_SECRET=your_app_secret_here

# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Public HTTPS URL for WhatsApp webhook (e.g., https://yourdomain.com/whatsapp)
WHATSAPP_WEBHOOK_URL=

# ============================================================
# TRANSCRIPTION SERVICE SETTINGS
# ============================================================
# Use local faster-whisper microservice (true/false)
USE_LOCAL_TRANSCRIPTION=true

# Transcription service URL (single-container Railway default)
TRANSCRIPTION_SERVICE_URL=http://127.0.0.1:5000

# Internal transcription listener settings
TRANSCRIPTION_HOST=127.0.0.1
TRANSCRIPTION_PORT=5000
TRANSCRIPTION_STARTUP_TIMEOUT_SECONDS=300
TRANSCRIPTION_STARTUP_INTERVAL_SECONDS=2

# Whisper model size (tiny, base, small, medium, large, large-v2, large-v3)
WHISPER_MODEL=base

# Local Faster-Whisper runtime settings
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE_DIR=.whisper_cache

# Default language for transcription (en, hi, mr, etc.)
WHISPER_LANGUAGE=en

# Transcription timeout in milliseconds
TRANSCRIPTION_TIMEOUT=60000

# Health/request retry settings
TRANSCRIPTION_HEALTH_TIMEOUT=3000
TRANSCRIPTION_RETRIES=3
TRANSCRIPTION_RETRY_DELAY_MS=1000

# Maximum file size in MB
MAX_FILE_SIZE_MB=25

# ============================================================
# OPENAI WHISPER API (FALLBACK)
# ============================================================
# OpenAI Whisper API key (leave empty to use local service only)
WHISPER_API_KEY=

# ============================================================
# GEMINI SETTINGS
# ============================================================
# Gemini API key from https://aistudio.google.com/app/apikey (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (defaults to gemini-1.5-flash for speed/cost)
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# GENERAL SETTINGS
# ============================================================
# Path to the official WLPA PDF (relative paths resolve from project root)
WLPA_PDF_PATH=assets/wlpa.pdf

# CORS origin for the health/admin endpoints
CORS_ORIGIN=*

# Default language fallback when detection fails (en | hi | mr)
DEFAULT_LANGUAGE=en
