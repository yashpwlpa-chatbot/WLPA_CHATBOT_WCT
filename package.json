{
  "name": "wlpa-telegram-bot",
  "version": "2.0.0",
  "description": "Telegram + WhatsApp chatbot for India's Wildlife (Protection) Act, 1972. Multilingual (EN/HI/MR), voice-message aware, with RAG pipeline, conversation memory, scenario understanding, and amendment knowledge.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest tests/integration --verbose",
    "test:watch": "jest tests/integration --watch",
    "test:coverage": "jest tests/integration --coverage",
    "lint": "eslint src/",
    "db:seed": "node scripts/seed-db.js",
    "transcription:dev": "cd transcription_service && python app.py",
    "transcription:build": "cd transcription_service && docker build -t wlpa-transcription .",
    "transcription:run": "docker-compose up transcription",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "nodemonConfig": {
    "ext": "js,mjs,cjs,json,env",
    "watch": ["*.*"]
  },
  "keywords": [
    "telegram",
    "bot",
    "wlpa",
    "wildlife",
    "india",
    "gemini",
    "ai",
    "multilingual",
    "voice",
    "rag",
    "conversation-memory",
    "whatsapp",
    "transcription"
  ],
  "author": "WLPA Bot Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "form-data": "^4.0.1",
    "franc-min": "^6.2.0",
    "fuse.js": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "node-telegram-bot-api": ">=0.66.0 <2.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.7"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/integration/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "!src/services/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true,
    "transformIgnorePatterns": [
      "node_modules/(?!(franc-min)/)"
    ],
    "moduleNameMapper": {
      "^franc-min$": "<rootDir>/node_modules/franc-min/index.js"
    }
  }
}